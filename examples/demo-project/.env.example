# Copy this file to .env and adjust the values for your machine.
# Every value below is a placeholder; none of them is used in production.

ORBIT_PORT=4180
ORBIT_HOST=127.0.0.1
ORBIT_LOG_LEVEL=info

# Optional: path to a JSON file used to seed the in-memory store on start.
ORBIT_SEED_FILE=data/sample-tasks.json

# Token required by orbitctl for write commands. Pick any local string.
ORBIT_API_TOKEN=replace-me-with-a-local-dev-token
